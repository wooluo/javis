# 凭证与本地环境
.env.local
.env
.venv/
.venv-mac/

# 运行日志与临时文件
*.log
nohup.out
logs/
__pycache__/
*.pyc

# LAN TLS 证书与私钥（scripts/make_lan_tls.sh 可重新生成，不入库）
scripts/lan_tls/

# 用户提供的音色素材与照片（个人材料，不入库）
assets/*/ref.wav
assets/*/ref.txt
assets/*/ref_original.wav
web/avatars/
ios/*/Assets.xcassets/AppIcon.appiconset/AppIcon.png

# macOS / 测试缓存
.DS_Store
.pytest_cache/

# Xcode 用户态
xcuserdata/

# 个人音色素材与克隆参考（隐私，绝不入库——edge 后端不读，仅 VoxCPM2 备用）
personas/*.wav
personas/*_ref*.txt
personas/*.bak-*
configs/*.bak-*
voxemw/pipeline/*.bak-*
web/rootCA.pem

# Mac 部署产物（2026-09-30）：venv 与本地模型目录绝不入库
main-env/
models/
