vad:
  backend: silero
  min_silence_ms: 64
stt:
  backend: qwen3asr
  model_name: Qwen/Qwen3-ASR-1.7B-hf
  device: cuda
  language: Chinese
  hotwords:
  - 小美
  corrections: {}
llm:
  backend: chat-completions
  model_name: glm-5.3-flash
  base_url: https://open.bigmodel.cn/api/coding/paas/v4
  api_key_env: ZHIPU_API_KEY
  stream: true
  stream_batch_sentences: 1
  chat_size: 30
  thinking_budget_tokens: 1024
tts:
  backend: voxcpm2
  model_name: openbmb/VoxCPM2
  cfg_value: 2.0
  inference_timesteps: 10
  device: cuda
rtc:
  enabled: false
  browser_ice_servers: []
vision:
  enabled: false
  vlm_url: http://127.0.0.1:18099
avatar:
  enabled: false
  url: ws://127.0.0.1:8791
  audio_lead_ms: 1300
personas:
  default: jarvis
  list:
    jarvis: personas/jarvis.md
server:
  s2s_host: 127.0.0.1
  s2s_port: 8765
  host: 0.0.0.0
  port: 8000
  log_level: info
  enable_live_transcription: false
  num_pipelines: 1
